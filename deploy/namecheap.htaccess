Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Canonical host and scheme: one permanent redirect to https://cicainfo.com.
# .well-known stays reachable over http for certificate validation.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^(www\.)?cicainfo\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://cicainfo.com%{REQUEST_URI} [L,R=301]

  # Hashed build assets never change under the same URL.
  RewriteRule ^_next/static/ - [E=CICA_IMMUTABLE:1]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"

  # HTML and small data files are always revalidated so a deploy shows up at once.
  <FilesMatch "\.(html|json|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Unhashed images change rarely: about 30 days.
  <FilesMatch "\.(webp|png|jpe?g|gif|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Must stay last so it overrides the image rule for build assets.
  Header set Cache-Control "public, max-age=31536000, immutable" env=CICA_IMMUTABLE
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
